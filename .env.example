# ── Discord application (https://discord.com/developers/applications) ──────
# General Information → Application ID
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Bot → Reset Token
DISCORD_TOKEN=

# ── Hosting ────────────────────────────────────────────────────────────────
# Public domain pointing at the server (used by Caddy for HTTPS), e.g. games.example.com
DOMAIN=

# ── Optional ───────────────────────────────────────────────────────────────
# Register commands to one test server only (instant updates while developing)
DEV_GUILD_ID=
# Days before untouched scores are deleted automatically
DATA_RETENTION_DAYS=90
# Check with Discord that each Activity player is really in that Activity instance
VERIFY_ACTIVITY_INSTANCE=true
