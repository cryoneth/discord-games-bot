{
  "name": "discord-games-bot",
  "version": "0.1.0",
  "description": "Privacy-focused party games for Discord: trivia, battle royale, word guess, duels and a drawing Activity.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json && vite build --config activity/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "register": "node --env-file-if-exists=.env dist/register.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p activity/tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "discord.js": "^14.28.1",
    "gifenc": "1.0.3",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
